# Upstox API credentials (from https://account.upstox.com/developer/apps)
# Prefer configuring via portal: Settings → Broker (stored in database).
# .env values are used as fallback when DB is empty.
UPSTOX_API_KEY=
UPSTOX_API_SECRET=
# Generated daily — paste in Settings → Broker or run: python scripts/upstox_login.py
UPSTOX_ACCESS_TOKEN=
# Optional — Analytic-Token from UpStox.txt (historical / Plus APIs)
UPSTOX_ANALYTIC_TOKEN=
# Must match Redirect URI registered in your Upstox app
# Use a distinct callback port from algo-flat (NIFTY) when both run on one host.
UPSTOX_REDIRECT_URL=http://127.0.0.1:8010/callback
UPSTOX_TOKEN_FILE=.upstox/session.json

# Flattrade (broker_config.provider: flattrade) — TOTP auto-login; token cached in DB + .flattrade/session.json
FLATTRADE_USER_ID=
FLATTRADE_API_KEY=
FLATTRADE_API_SECRET=
FLATTRADE_PASSWORD=
FLATTRADE_TOTP_SECRET=
FLATTRADE_ACCESS_TOKEN=
FLATTRADE_REDIRECT_URL=http://127.0.0.1:8010/callback
FLATTRADE_TOKEN_FILE=.flattrade/session.json

# Runtime
TRADING_MODE=paper
CONFIG_DIR=./config
LOG_LEVEL=INFO

# Database — isolated from algo-flat (NIFTY) defaults
POSTGRES_USER=algoflatsx
POSTGRES_PASSWORD=algoflatsx
POSTGRES_DB=algoflatsx
DATABASE_URL=postgresql://algoflatsx:algoflatsx@postgres:5432/algoflatsx

# Host ports — do not overlap algo-flat (8080 / 8001 / 5432)
WEB_PORT=8081
ENGINE_PORT=8002
POSTGRES_PORT=5433

# Web dashboard login (change before production!)
WEB_USERNAME=admin
WEB_PASSWORD=algoflatsx
JWT_SECRET=change-me-sensex-use-long-random-string

# Telegram alerts (create bot via @BotFather, then tap Start in chat)
# Prefer a separate bot/chat from the NIFTY stack.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_ALERTS_ENABLED=true
